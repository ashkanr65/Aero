{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/renderer/**/*",
    "src/shared/**/*",
    "src/main/keyboard-shortcuts.ts",
    "src/preload/**/*"
  ]
}